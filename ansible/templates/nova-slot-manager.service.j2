# {{ ansible_managed }}
#
# The subnet-68 slot purchase agent. It lives on an always-on node rather than a
# laptop because the recycle price halves every 360 blocks (72 minutes), so
# buying cheaply means being awake for the quiet intervals. A host that sleeps
# misses them.
#
# The coldkey password arrives through LoadCredentialEncrypted, not Environment=.
# That is deliberate: a credential is decrypted into a tmpfs directory readable
# only by this unit, so the value never appears in this file, in
# `systemctl show`, in /proc/<pid>/environ, or in a core dump of a child.
#
# Encrypt it once on THIS host (the encryption is host-bound), as root:
#   systemd-ask-password -n | systemd-creds encrypt --name={{ slot_manager_credential_name }} - {{ slot_manager_credential_path }}
#   chmod 0600 {{ slot_manager_credential_path }}
#
{% if slot_manager_execute | bool %}
# THIS UNIT SPENDS TAO. It was rendered with slot_manager_execute=true, so
# ExecStart below carries --execute-registrations and every timer tick can burn
# up to {{ slot_manager_max_spend_tao_per_day }} TAO/day buying registrations.
# Re-run ansible/slots.yml without -e slot_manager_execute=true to return it to
# a dry run.
{% else %}
# This unit is a DRY RUN. --execute-registrations is what spends tao and is not
# present below; live purchase comes from -e slot_manager_execute=true, which
# also changes the Description so `systemctl status` cannot misreport the mode.
{% endif %}
[Unit]
# The mode is in the Description on purpose. A unit that says "dry run" while it
# buys registrations makes `systemctl status`, `systemctl list-timers` and every
# journal start/finish line a false report of what the machine is doing -- which
# is exactly what this deployment did until it was caught spending 0.229 TAO
# under a description that claimed it was not spending anything.
Description=Nova subnet-68 slot purchase check ({{ 'LIVE -- SPENDS TAO' if slot_manager_execute | bool else 'dry run' }})
Documentation=file://{{ slot_manager_repo }}/nanobody_opt/slot_manager.py
After=network-online.target
Wants=network-online.target

[Service]
# Runs as the wallet's owner, not root. The coldkey and the decision log belong
# to this user, and a process that signs chain writes has no reason to be root.
User={{ slot_manager_user }}
Group={{ slot_manager_user }}
Environment=HOME={{ slot_manager_home }}
# oneshot driven by nova-slot-manager.timer, not a resident loop. The agent
# keeps its price history in the decision log precisely so single-shot runs
# accumulate state, and a process that exits between checks is one that cannot
# wedge holding a decrypted coldkey. A timer also survives reboots, which a Pi
# does regularly.
Type=oneshot
WorkingDirectory={{ slot_manager_repo }}
Environment=PYTHONUNBUFFERED=1
# The NAME of the credential, never its value.
Environment={{ slot_manager_keychain_service_env }}={{ slot_manager_credential_name }}
LoadCredentialEncrypted={{ slot_manager_credential_name }}:{{ slot_manager_credential_path }}
# Serialize every operation that unlocks this coldkey.  The daily
# infrastructure sweep uses the same lock, so an alpha conversion/transfer can
# never overlap a slot registration.
ExecStart=/usr/bin/flock --exclusive --wait 240 /run/lock/nova-coldkey.lock {{ slot_manager_exec }}
# A registration is a chain write; never run two of these at once. The timer
# does not stack runs, and oneshot means systemd will not start a second while
# the first is still going.
StandardOutput=journal
StandardError=journal
# The coldkey is the only thing on this host worth stealing.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# ProtectHome is off because the wallet and the decision log both live in this
# user's home; ProtectSystem=strict still makes everything else read-only, and
# only the two paths below are writable.
ProtectHome=false
ReadWritePaths={{ slot_manager_decision_log | dirname }} {{ slot_manager_home }}/.bittensor
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

# No [Install]: the timer is what gets enabled, not the service. Enabling this
# unit directly would run one check at boot and never again.
