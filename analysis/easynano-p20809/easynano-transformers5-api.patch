diff --git a/easynano/transformers_compat.py b/easynano/transformers_compat.py
new file mode 100644
index 0000000..43c538d
--- /dev/null
+++ b/easynano/transformers_compat.py
@@ -0,0 +1,62 @@
+"""Compatibility helpers for the split Transformers 5 ESMFold2 API."""
+from __future__ import annotations
+
+import inspect
+
+
+_ATOM_KEYS = (
+    "ref_pos",
+    "ref_charge",
+    "atom_attention_mask",
+    "ref_element",
+    "ref_atom_name_chars",
+    "ref_space_uid",
+    "atom_to_token",
+)
+
+
+def _uses_split_api(model) -> bool:
+    """Return whether structure folding moved from ``forward`` to ``fold``."""
+    return hasattr(model, "fold") and "atom_inputs" in inspect.signature(model.forward).parameters
+
+
+def differentiable_trunk(model, features: dict, *, num_loops: int):
+    """Run a differentiable trunk pass and return distogram logits."""
+    if not _uses_split_api(model):
+        return model.forward(
+            **features,
+            num_loops=num_loops,
+            num_sampling_steps=1,
+            num_diffusion_samples=1,
+            calculate_confidence=True,
+        )
+    from transformers.models.esmfold2.modeling_esmfold2 import EsmFold2AtomInputs
+
+    inputs = dict(features)
+    atom_inputs = EsmFold2AtomInputs(**{key: inputs.pop(key) for key in _ATOM_KEYS})
+    return model.forward(**inputs, atom_inputs=atom_inputs, num_loops=num_loops)
+
+
+def fold_structure(
+    model,
+    features: dict,
+    *,
+    num_loops: int,
+    num_sampling_steps: int,
+    num_diffusion_samples: int,
+):
+    """Run the full structure/confidence path on old and split APIs."""
+    if _uses_split_api(model):
+        return model.fold(
+            **features,
+            num_loops=num_loops,
+            num_sampling_steps=num_sampling_steps,
+            num_diffusion_samples=num_diffusion_samples,
+        )
+    return model.forward(
+        **features,
+        num_loops=num_loops,
+        num_sampling_steps=num_sampling_steps,
+        num_diffusion_samples=num_diffusion_samples,
+        calculate_confidence=True,
+    )
