+def enable_eval_gradient_checkpointing(model) -> int:
+    """Checkpoint split-API pair layers without enabling training-time dropout."""
+    if not _uses_split_api(model):
+        return 0
+    from transformers.modeling_layers import GradientCheckpointingLayer
+
+    model.gradient_checkpointing_enable(
+        gradient_checkpointing_kwargs={"use_reentrant": False},
+    )
+    layers = [module for module in model.modules() if isinstance(module, GradientCheckpointingLayer)]
+    for layer in layers:
+        # GradientCheckpointingLayer gates checkpointing on its own ``training``
+        # flag. Its ESMFold2 pair-update forward is explicitly dropout-free, so
+        # this does not switch the otherwise-eval model into stochastic mode.
+        layer.training = True
+    return len(layers)
+
